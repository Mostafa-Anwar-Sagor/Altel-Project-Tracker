# ─────────────────────────────────────────────────────────────────────────────
# ProTracker — Azure App Service environment variables
# Copy this to .env and fill in the real values before deploying.
# Set these in Azure Portal → App Service → Configuration → Application settings
# ─────────────────────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=CHANGE-ME-use-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=your-app-name.azurewebsites.net

# CORS — allow your Azure Static Web App frontend
CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net

# Database (SQLite — fine for single-instance B1 App Service)
# Data is stored at /home/db.sqlite3 on persistent storage
# No extra env var needed — SQLite path is set in settings.py

# Email (optional — configure in Settings page after deploy)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=ProTracker <noreply@yourdomain.com>

# Disable Redis (use in-memory broker for simplicity)
USE_REDIS=False
